# Vuelve Backend Environment Variables
# Copia este archivo a .env y configura con tus valores

# Puerto del servidor
PORT=3000

# JWT Secret (cambiar en producción)
JWT_SECRET=tu-secret-key-muy-seguro-aqui

# Supabase (PostgreSQL en la nube)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key

# Base de datos (opcional si usas Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/vuelve

# Firebase (para push notifications)
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_PRIVATE_KEY=tu-private-key
FIREBASE_CLIENT_EMAIL=tu-email@firebase.gserviceaccount.com

# SendGrid (para emails)
SENDGRID_API_KEY=SG.tu-api-key

# Khipu (pasarela de pagos)
KHIPU_MERCHANT_ID=tu-merchant-id
KHIPU_API_KEY=tu-api-key

# Claude API (para recordatorios inteligentes)
CLAUDE_API_KEY=sk-ant-tu-api-key

# Entorno
NODE_ENV=development

# Logs
LOG_LEVEL=debug

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://vuelve.cl

# Redis (opcional para sesiones/cache)
REDIS_URL=redis://localhost:6379
